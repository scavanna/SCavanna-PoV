// Propuestas de triage; filtro opcional: | where AlertType == "<ID exacto>"
_GetWatchlist('MDCAI_V3_Relations')
| where MappingVersion == "3.0.0"
| project AlertType=tostring(SearchKey), Framework, FrameworkVersion, TargetId, TargetName, Relation, EvidenceNeeded, TargetUrl
| order by AlertType asc, Framework asc, TargetId asc
