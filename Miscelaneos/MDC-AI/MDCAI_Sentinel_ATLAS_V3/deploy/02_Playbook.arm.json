{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "3.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string"
    },
    "playbookName": {
      "type": "string",
      "defaultValue": "Enrich-MDCAI-ATLAS-v3"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "workflowState": {
      "type": "string",
      "defaultValue": "Disabled",
      "allowedValues": [
        "Disabled",
        "Enabled"
      ]
    },
    "writeToIncident": {
      "type": "bool",
      "defaultValue": false
    },
    "includeModelScan": {
      "type": "bool",
      "defaultValue": false
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('connectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "[variables('connectionName')]",
        "parameterValueType": "Alternative",
        "customParameterValues": {},
        "api": {
          "id": "[variables('connectorId')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('playbookName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('connectionName'))]"
      ],
      "properties": {
        "state": "[parameters('workflowState')]",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object"
            },
            "profiles": {
              "type": "Object"
            },
            "workspaceResourceId": {
              "type": "String"
            },
            "armBase": {
              "type": "String"
            },
            "armAudience": {
              "type": "String"
            },
            "productNamesLower": {
              "type": "Array"
            },
            "writeToIncident": {
              "type": "Bool"
            },
            "includeModelScan": {
              "type": "Bool"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "path": "/incident-creation",
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "runs": 1
                },
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              }
            }
          },
          "actions": {
            "IncidentArmId": {
              "type": "Compose",
              "inputs": "@string(triggerBody()?['object']?['id'])",
              "runAfter": {}
            },
            "IncidentLeaf": {
              "type": "Compose",
              "inputs": "@last(split(outputs('IncidentArmId'), '/'))",
              "runAfter": {
                "IncidentArmId": [
                  "Succeeded"
                ]
              }
            },
            "TrustedIncidentPath": {
              "type": "Compose",
              "inputs": "@concat(parameters('workspaceResourceId'), '/providers/Microsoft.SecurityInsights/incidents/', encodeUriComponent(outputs('IncidentLeaf')))",
              "runAfter": {
                "IncidentLeaf": [
                  "Succeeded"
                ]
              }
            },
            "InitLines": {
              "type": "InitializeVariable",
              "runAfter": {
                "TrustedIncidentPath": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "variables": [
                  {
                    "name": "Lines",
                    "type": "Array",
                    "value": []
                  }
                ]
              }
            },
            "InitTags": {
              "type": "InitializeVariable",
              "runAfter": {
                "InitLines": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "variables": [
                  {
                    "name": "Tags",
                    "type": "Array",
                    "value": [
                      "MDCAI:V3:Propuesto"
                    ]
                  }
                ]
              }
            },
            "InitUnknown": {
              "type": "InitializeVariable",
              "runAfter": {
                "InitTags": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "variables": [
                  {
                    "name": "Unknown",
                    "type": "Boolean",
                    "value": false
                  }
                ]
              }
            },
            "WorkspaceBoundary": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@toLower(outputs('TrustedIncidentPath'))",
                      "@toLower(outputs('IncidentArmId'))"
                    ]
                  },
                  {
                    "equals": [
                      "@length(outputs('IncidentLeaf'))",
                      36
                    ]
                  }
                ]
              },
              "actions": {
                "ListIncidentAlerts": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@concat(parameters('armBase'), outputs('TrustedIncidentPath'), '/alerts?api-version=2025-09-01')",
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "audience": "@parameters('armAudience')"
                    }
                  },
                  "runAfter": {},
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  }
                },
                "FilterCandidates": {
                  "type": "Query",
                  "runAfter": {
                    "ListIncidentAlerts": [
                      "Succeeded"
                    ]
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  },
                  "inputs": {
                    "from": "@body('ListIncidentAlerts')?['value']",
                    "where": "@and(equals(toLower(string(item()?['kind'])), 'securityalert'), contains(parameters('productNamesLower'), toLower(string(item()?['properties']?['productName']))), or(startsWith(string(item()?['properties']?['alertType']), 'AI.Azure_'), and(parameters('includeModelScan'), startsWith(string(item()?['properties']?['alertType']), 'AI.AIModelScan_'))))"
                  }
                },
                "SelectTypes": {
                  "type": "Select",
                  "runAfter": {
                    "FilterCandidates": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@body('FilterCandidates')",
                    "select": {
                      "typeId": "@item()?['properties']?['alertType']"
                    }
                  }
                },
                "ForEachType": {
                  "type": "Foreach",
                  "runAfter": {
                    "SelectTypes": [
                      "Succeeded"
                    ]
                  },
                  "operationOptions": "Sequential",
                  "foreach": "@sort(union(body('SelectTypes'), body('SelectTypes')), 'typeId')",
                  "actions": {
                    "KnownProfile": {
                      "type": "If",
                      "expression": {
                        "equals": [
                          "@contains(parameters('profiles'), items('ForEachType')?['typeId'])",
                          true
                        ]
                      },
                      "actions": {
                        "Profile": {
                          "type": "Compose",
                          "inputs": "@parameters('profiles')[items('ForEachType')?['typeId']]",
                          "runAfter": {}
                        },
                        "AppendLine": {
                          "type": "AppendToArrayVariable",
                          "inputs": {
                            "name": "Lines",
                            "value": "@outputs('Profile')?['line']"
                          },
                          "runAfter": {
                            "Profile": [
                              "Succeeded"
                            ]
                          }
                        },
                        "ForEachTag": {
                          "type": "Foreach",
                          "runAfter": {
                            "AppendLine": [
                              "Succeeded"
                            ]
                          },
                          "operationOptions": "Sequential",
                          "foreach": "@outputs('Profile')?['tags']",
                          "actions": {
                            "AppendTag": {
                              "type": "AppendToArrayVariable",
                              "inputs": {
                                "name": "Tags",
                                "value": "@items('ForEachTag')"
                              },
                              "runAfter": {}
                            }
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "MarkUnknown": {
                            "type": "SetVariable",
                            "inputs": {
                              "name": "Unknown",
                              "value": true
                            },
                            "runAfter": {}
                          }
                        }
                      },
                      "runAfter": {}
                    }
                  }
                },
                "IfUnknown": {
                  "type": "If",
                  "expression": {
                    "equals": [
                      "@variables('Unknown')",
                      true
                    ]
                  },
                  "actions": {
                    "AppendUnknownNote": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Lines",
                        "value": "<div>Hay alertas IA candidatas sin clasificación en esta versión. Consultar QA y el incidente original.</div>"
                      },
                      "runAfter": {}
                    },
                    "AppendReviewTag": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Tags",
                        "value": "MDCAI:V3:Revisar"
                      },
                      "runAfter": {
                        "AppendUnknownNote": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "ForEachType": [
                      "Succeeded"
                    ]
                  }
                },
                "TagObjects": {
                  "type": "Select",
                  "runAfter": {
                    "IfUnknown": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@union(variables('Tags'), variables('Tags'))",
                    "select": {
                      "Tag": "@item()"
                    }
                  }
                },
                "Plan": {
                  "type": "Compose",
                  "inputs": {
                    "version": "3.0.0",
                    "atlasVersion": "2026.10",
                    "distinctTypes": "@length(union(body('SelectTypes'), body('SelectTypes')))",
                    "remarks": "@variables('Lines')",
                    "tags": "@body('TagObjects')"
                  },
                  "runAfter": {
                    "TagObjects": [
                      "Succeeded"
                    ]
                  }
                },
                "ApplyOnlyWhenEnabled": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@parameters('writeToIncident')",
                          true
                        ]
                      },
                      {
                        "greater": [
                          "@length(variables('Lines'))",
                          0
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "GetExistingComment": {
                      "type": "Http",
                      "inputs": {
                        "method": "GET",
                        "uri": "@concat(parameters('armBase'), outputs('TrustedIncidentPath'), '/comments/7ee0f2bb-ea25-57fc-beed-376269adcb7e?api-version=2025-09-01')",
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "@parameters('armAudience')"
                        }
                      },
                      "runAfter": {}
                    },
                    "NewComment": {
                      "type": "Compose",
                      "inputs": "@concat('<div><b>MDCAI V3.0.0 · clasificación propuesta · ATLAS 2026.10</b><br/>No modifica la alerta ni prueba éxito o cobertura.</div>', join(variables('Lines'), ''))",
                      "runAfter": {}
                    },
                    "WriteIfChanged": {
                      "type": "If",
                      "expression": {
                        "or": [
                          {
                            "equals": [
                              "@outputs('GetExistingComment')?['statusCode']",
                              404
                            ]
                          },
                          {
                            "and": [
                              {
                                "equals": [
                                  "@outputs('GetExistingComment')?['statusCode']",
                                  200
                                ]
                              },
                              {
                                "not": {
                                  "equals": [
                                    "@body('GetExistingComment')?['properties']?['message']",
                                    "@outputs('NewComment')"
                                  ]
                                }
                              }
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "UpsertComment": {
                          "type": "Http",
                          "inputs": {
                            "method": "PUT",
                            "uri": "@concat(parameters('armBase'), outputs('TrustedIncidentPath'), '/comments/7ee0f2bb-ea25-57fc-beed-376269adcb7e?api-version=2025-09-01')",
                            "authentication": {
                              "type": "ManagedServiceIdentity",
                              "audience": "@parameters('armAudience')"
                            },
                            "body": {
                              "properties": {
                                "message": "@outputs('NewComment')"
                              }
                            },
                            "headers": {
                              "Content-Type": "application/json"
                            }
                          },
                          "runAfter": {}
                        }
                      },
                      "else": {
                        "actions": {}
                      },
                      "runAfter": {
                        "GetExistingComment": [
                          "Succeeded",
                          "Failed"
                        ],
                        "NewComment": [
                          "Succeeded"
                        ]
                      }
                    },
                    "CheckCommentReadStatus": {
                      "type": "If",
                      "expression": {
                        "or": [
                          {
                            "equals": [
                              "@outputs('GetExistingComment')?['statusCode']",
                              200
                            ]
                          },
                          {
                            "equals": [
                              "@outputs('GetExistingComment')?['statusCode']",
                              404
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "AddTags": {
                          "type": "ApiConnection",
                          "runAfter": {},
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                              }
                            },
                            "method": "put",
                            "path": "/Incidents/Tags",
                            "body": {
                              "incidentArmId": "@outputs('TrustedIncidentPath')",
                              "tagsToAdd": {
                                "TagsToAdd": "@body('TagObjects')"
                              }
                            }
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "CommentReadFailed": {
                            "type": "Terminate",
                            "runAfter": {},
                            "inputs": {
                              "runStatus": "Failed",
                              "runError": {
                                "code": "CommentRead",
                                "message": "No se pudo leer el comentario. Revisar la respuesta y RBAC."
                              }
                            }
                          }
                        }
                      },
                      "runAfter": {
                        "WriteIfChanged": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "Plan": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "RejectWorkspace": {
                    "type": "Terminate",
                    "runAfter": {},
                    "inputs": {
                      "runStatus": "Failed",
                      "runError": {
                        "code": "WrongWorkspace",
                        "message": "El incidente no pertenece al workspace parametrizado."
                      }
                    }
                  }
                }
              },
              "runAfter": {
                "InitUnknown": [
                  "Succeeded"
                ]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "id": "[variables('connectorId')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('connectionName'))]",
                "connectionName": "[variables('connectionName')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          },
          "workspaceResourceId": {
            "value": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]"
          },
          "armBase": {
            "value": "[if(endsWith(environment().resourceManager, '/'), substring(environment().resourceManager, 0, sub(length(environment().resourceManager), 1)), environment().resourceManager)]"
          },
          "armAudience": {
            "value": "[environment().resourceManager]"
          },
          "profiles": {
            "value": {
              "AI.Azure_CredentialTheftAttempt": {
                "line": "<div><a href=\"https://learn.microsoft.com/en-us/azure/defender-for-cloud/alerts-ai-workloads#detected-credential-theft-attempts-on-an-azure-ai-model-deployment\">AI.Azure_CredentialTheftAttempt</a> · <a href=\"https://learn.microsoft.com/en-us/security/zero-trust/catalog-ai-attack-techniques/sensitive-information-disclosure\">CAAT-07</a> · <a href=\"https://github.com/GenAI-Security-Project/GenAI-LLM-Top10/blob/main/2026/final/LLM02_SensitiveInformationDisclosure.md\">LLM02:2026</a><br/>Verificar clasificación, validez, origen y destinatario en un canal restringido. Gestionar rotación si se confirma exposición.<br/>No prueba robo, uso posterior, origen en RAG/memoria ni transferencia no autorizada.<br/>Vínculos no automáticos: 3; consultar la matriz V3.</div>",
                "tags": [
                  "MDCAI:CAAT:07",
                  "MDCAI:OWASP:2026:LLM02"
                ],
                "scope": "runtime",
                "atlasVersion": "2026.10"
              },
              "AI.Azure_Jailbreak.ContentFiltering.BlockedAttempt": {
                "line": "<div><a href=\"https://learn.microsoft.com/en-us/azure/defender-for-cloud/alerts-ai-workloads#a-jailbreak-attempt-on-an-azure-ai-model-deployment-was-blocked-by-azure-ai-content-safety-prompt-shields\">AI.Azure_Jailbreak.ContentFiltering.BlockedAttempt</a> · <a href=\"https://learn.microsoft.com/en-us/security/zero-trust/catalog-ai-attack-techniques/prompt-injection\">CAAT-02</a> · <a href=\"https://atlas.mitre.org/techniques/AML.T0054\">AML.T0054</a> · <a href=\"https://atlas.mitre.org/techniques/AML.T0051.000\">AML.T0051.000</a> · <a href=\"https://github.com/GenAI-Security-Project/GenAI-LLM-Top10/blob/main/2026/final/LLM01_PromptInjection.md\">LLM01:2026</a><br/>Confirmar el veredicto bloqueado y el despliegue. Buscar otras alertas independientes del mismo recurso o sesión.<br/>El bloqueo de esta solicitud no confirma ni descarta compromiso en otras interacciones.</div>",
                "tags": [
                  "MDCAI:ATLAS:AML.T0051.000",
                  "MDCAI:ATLAS:AML.T0054",
                  "MDCAI:CAAT:02",
                  "MDCAI:OWASP:2026:LLM01"
                ],
                "scope": "runtime",
                "atlasVersion": "2026.10"
              },
              "AI.Azure_Jailbreak.ContentFiltering.DetectedAttempt": {
                "line": "<div><a href=\"https://learn.microsoft.com/en-us/azure/defender-for-cloud/alerts-ai-workloads#a-jailbreak-attempt-on-an-azure-ai-model-deployment-was-detected-by-azure-ai-content-safety-prompt-shields\">AI.Azure_Jailbreak.ContentFiltering.DetectedAttempt</a> · <a href=\"https://learn.microsoft.com/en-us/security/zero-trust/catalog-ai-attack-techniques/prompt-injection\">CAAT-02</a> · <a href=\"https://atlas.mitre.org/techniques/AML.T0054\">AML.T0054</a> · <a href=\"https://atlas.mitre.org/techniques/AML.T0051.000\">AML.T0051.000</a> · <a href=\"https://github.com/GenAI-Security-Project/GenAI-LLM-Top10/blob/main/2026/final/LLM01_PromptInjection.md\">LLM01:2026</a><br/>Verificar configuración y veredicto de filtros. Revisar evidencia autorizada para saber si hubo salida o acción no prevista.<br/>No bloqueado no significa jailbreak exitoso ni exfiltración.</div>",
                "tags": [
                  "MDCAI:ATLAS:AML.T0051.000",
                  "MDCAI:ATLAS:AML.T0054",
                  "MDCAI:CAAT:02",
                  "MDCAI:OWASP:2026:LLM01"
                ],
                "scope": "runtime",
                "atlasVersion": "2026.10"
              },
              "AI.Azure_MaliciousUrl.ModelResponse": {
                "line": "<div><a href=\"https://learn.microsoft.com/en-us/azure/defender-for-cloud/alerts-ai-workloads#corrupted-ai-applicationmodeldata-directed-a-phishing-attempt-at-a-user\">AI.Azure_MaliciousUrl.ModelResponse</a> · sin vínculo directo<br/>Correlacionar con telemetría de Click/Proxy autorizada y revisar procedencia del dato y controles de salida.<br/>La URL en la respuesta no distingue origen app/modelo/datos ni confirma compromiso del usuario.<br/>Vínculos no automáticos: 4; consultar la matriz V3.</div>",
                "tags": [],
                "scope": "runtime",
                "atlasVersion": "2026.10"
              },
              "AI.Azure_MaliciousUrl.UnknownSource": {
                "line": "<div><a href=\"https://learn.microsoft.com/en-us/azure/defender-for-cloud/alerts-ai-workloads#phishing-url-shared-in-an-ai-application\">AI.Azure_MaliciousUrl.UnknownSource</a> · sin vínculo directo<br/>Determinar la dirección de la interacción y correlacionar el indicador sin abrir la URL.<br/>Por sí sola no prueba inyección indirecta ni envenenamiento.<br/>Vínculos no automáticos: 2; consultar la matriz V3.</div>",
                "tags": [],
                "scope": "runtime",
                "atlasVersion": "2026.10"
              },
              "AI.Azure_MaliciousUrl.UserPrompt": {
                "line": "<div><a href=\"https://learn.microsoft.com/en-us/azure/defender-for-cloud/alerts-ai-workloads#phishing-attempt-detected-in-an-ai-application\">AI.Azure_MaliciousUrl.UserPrompt</a> · sin vínculo directo<br/>Determinar si el usuario reportaba un indicador, era destinatario o actuaba como origen. Revisar el resultado de la interacción.<br/>Un indicador citado en un prompt no equivale a prompt injection ni atribuye intención.<br/>Vínculos no automáticos: 2; consultar la matriz V3.</div>",
                "tags": [],
                "scope": "runtime",
                "atlasVersion": "2026.10"
              },
              "AI.Azure_AccessFromSuspiciousUserAgent": {
                "line": "<div><a href=\"https://learn.microsoft.com/en-us/azure/defender-for-cloud/alerts-ai-workloads#suspicious-user-agent-detected\">AI.Azure_AccessFromSuspiciousUserAgent</a> · sin vínculo directo<br/>Confirmar contexto mediante gateway y volumen; descartar automatización legítima.<br/>El User-Agent no demuestra escaneo, jailbreak, robo de modelo ni abuso de costos.<br/>Vínculos no automáticos: 1; consultar la matriz V3.</div>",
                "tags": [],
                "scope": "runtime",
                "atlasVersion": "2026.10"
              },
              "AI.Azure_ASCIISmuggling": {
                "line": "<div><a href=\"https://learn.microsoft.com/en-us/azure/defender-for-cloud/alerts-ai-workloads#ascii-smuggling-prompt-injection-detected\">AI.Azure_ASCIISmuggling</a> · <a href=\"https://learn.microsoft.com/en-us/security/zero-trust/catalog-ai-attack-techniques/prompt-injection\">CAAT-02</a> · <a href=\"https://atlas.mitre.org/techniques/AML.T0068\">AML.T0068</a> · <a href=\"https://github.com/GenAI-Security-Project/GenAI-LLM-Top10/blob/main/2026/final/LLM01_PromptInjection.md\">LLM01:2026</a><br/>Establecer origen del contenido y si el modelo llegó a procesarlo; revisar los registros autorizados, sin redistribuir contenido.<br/>La opacidad no prueba que el contenido provino de una fuente externa o que el modelo obedeció.<br/>Vínculos no automáticos: 1; consultar la matriz V3.</div>",
                "tags": [
                  "MDCAI:ATLAS:AML.T0068",
                  "MDCAI:CAAT:02",
                  "MDCAI:OWASP:2026:LLM01"
                ],
                "scope": "runtime",
                "atlasVersion": "2026.10"
              },
              "AI.Azure_AccessFromAnonymizedIP": {
                "line": "<div><a href=\"https://learn.microsoft.com/en-us/azure/defender-for-cloud/alerts-ai-workloads#access-from-a-tor-ip\">AI.Azure_AccessFromAnonymizedIP</a> · sin vínculo directo<br/>Validar el origen confiable y la ruta de red; revisar cambios en el patrón de uso.<br/>Tor puede tener uso legítimo. No atribuir una técnica ATLAS de ataque solo por la IP.<br/>Vínculos no automáticos: 1; consultar la matriz V3.</div>",
                "tags": [],
                "scope": "runtime",
                "atlasVersion": "2026.10"
              },
              "AI.Azure_AccessFromSuspiciousIP": {
                "line": "<div><a href=\"https://learn.microsoft.com/en-us/azure/defender-for-cloud/alerts-ai-workloads#access-from-suspicious-ip\">AI.Azure_AccessFromSuspiciousIP</a> · sin vínculo directo<br/>Validar IP efectiva, fecha de inteligencia, autenticación y alcance; contrastar contra proxies o pools compartidos.<br/>La reputación IP no demuestra autenticación con credenciales robadas ni consumo excesivo.<br/>Vínculos no automáticos: 1; consultar la matriz V3.</div>",
                "tags": [],
                "scope": "runtime",
                "atlasVersion": "2026.10"
              },
              "AI.Azure_DOWDuplicateRequests": {
                "line": "<div><a href=\"https://learn.microsoft.com/en-us/azure/defender-for-cloud/alerts-ai-workloads#suspected-wallet-attack---recurring-requests\">AI.Azure_DOWDuplicateRequests</a> · <a href=\"https://learn.microsoft.com/en-us/security/zero-trust/catalog-ai-attack-techniques/unbounded-ai-consumption-and-agentic-dos\">CAAT-05</a> · <a href=\"https://github.com/GenAI-Security-Project/GenAI-LLM-Top10/blob/main/2026/final/LLM06_UnboundedConsumption.md\">LLM06:2026</a><br/>Correlacionar con solicitudes, cuotas y costos. Separar reintentos legítimos, pruebas de carga y errores de integración.<br/>No declara intención adversaria, pérdida financiera ni caída del servicio.<br/>Vínculos no automáticos: 3; consultar la matriz V3.</div>",
                "tags": [
                  "MDCAI:CAAT:05",
                  "MDCAI:OWASP:2026:LLM06"
                ],
                "scope": "runtime",
                "atlasVersion": "2026.10"
              },
              "AI.Azure_DOWVolumeAnomaly": {
                "line": "<div><a href=\"https://learn.microsoft.com/en-us/azure/defender-for-cloud/alerts-ai-workloads#suspected-wallet-attack---volume-anomaly\">AI.Azure_DOWVolumeAnomaly</a> · <a href=\"https://learn.microsoft.com/en-us/security/zero-trust/catalog-ai-attack-techniques/unbounded-ai-consumption-and-agentic-dos\">CAAT-05</a> · <a href=\"https://github.com/GenAI-Security-Project/GenAI-LLM-Top10/blob/main/2026/final/LLM06_UnboundedConsumption.md\">LLM06:2026</a><br/>Comparar uso y costos con la línea base, despliegues y cambios de tráfico. Revisar atribución a aplicación o cuenta.<br/>Un pico anómalo no equivale a técnica confirmada, pérdida ni interrupción.<br/>Vínculos no automáticos: 2; consultar la matriz V3.</div>",
                "tags": [
                  "MDCAI:CAAT:05",
                  "MDCAI:OWASP:2026:LLM06"
                ],
                "scope": "runtime",
                "atlasVersion": "2026.10"
              },
              "AI.Azure_AccessAnomaly": {
                "line": "<div><a href=\"https://learn.microsoft.com/en-us/azure/defender-for-cloud/alerts-ai-workloads#access-anomaly-in-ai-resource\">AI.Azure_AccessAnomaly</a> · sin vínculo directo<br/>Verificar si hubo cambios aprobados de identidad, clientes o infraestructura; vincular solo con telemetría independiente.<br/>El cambio de patrón no prueba robo de modelo, abuso de volumen o credencial comprometida.<br/>Vínculos no automáticos: 2; consultar la matriz V3.</div>",
                "tags": [],
                "scope": "runtime",
                "atlasVersion": "2026.10"
              },
              "AI.Azure_AnomalousOperation.InitialAccess": {
                "line": "<div><a href=\"https://learn.microsoft.com/en-us/azure/defender-for-cloud/alerts-ai-workloads#suspicious-invocation-of-a-high-risk-initial-access-operation-by-a-service-principal-detected-ai-resources\">AI.Azure_AnomalousOperation.InitialAccess</a> · sin vínculo directo<br/>Consultar AzureActivity e inicios de sesión de service principals; confirmar operación exacta, identidad y cambio autorizado.<br/>No presupone un nombre de operación, robo de claves ni compromiso de la cadena de suministro.<br/>Vínculos no automáticos: 2; consultar la matriz V3.</div>",
                "tags": [],
                "scope": "runtime",
                "atlasVersion": "2026.10"
