{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Biblioteca GM-24 — contratos JSONL de publicación",
  "$defs": {
    "unit": {
      "type": "string",
      "pattern": "^[GM][1-6]\\.[12]$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^(?:[GM][1-6]\\.[12]-K(?:0[1-9]|10)|AMP-(?:0[1-9]|[1-4][0-9]|5[01])|HC-(?:00[1-9]|0[1-3][0-9]|040)|(?:APC|APA)-[0-9]{3}|APN-[0-9]{2})$"
    },
    "catalog": {
      "type": "object",
      "required": ["id", "name", "type", "status", "unit", "related_units", "statement", "source"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 2},
        "type": {"enum": ["base", "atlas", "hybrid", "question_derived"]},
        "status": {"type": "string", "minLength": 10},
        "unit": {"oneOf": [{"$ref": "#/$defs/unit"}, {"type": "null"}]},
        "related_units": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/unit"}},
        "statement": {"type": "string", "minLength": 20},
        "questions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:PC|PA|PN)-[0-9]{2,3}$"}},
        "generated_bm_count": {"type": "integer", "minimum": 3, "maximum": 5},
        "origin_question": {"type": "string", "pattern": "^(?:PC|PA|PN)-[0-9]{2,3}$"},
        "specializes": {"type": "string"},
        "source": {"type": "string", "minLength": 10}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "question_derived"}}, "required": ["type"]},
          "then": {"required": ["origin_question", "specializes"]},
          "else": {"required": ["questions", "generated_bm_count"]}
        },
        {
          "if": {"properties": {"type": {"const": "hybrid"}}, "required": ["type"]},
          "then": {"properties": {"unit": {"type": "null"}}}
        }
      ]
    },
    "question": {
      "type": "object",
      "required": ["id", "text", "form", "direct_id", "gm24_id", "bank_id", "origin", "origin_id", "source_locator", "related_thesis", "related_thesis_status", "type"],
      "properties": {
        "id": {"type": "string", "pattern": "^(?:PC|PA|PN)-[0-9]{2,3}$"},
        "text": {"type": "string", "minLength": 10},
        "form": {"enum": ["interrogativa", "petición imperativa"]},
        "direct_id": {"$ref": "#/$defs/identifier"},
        "gm24_id": {"type": "string"},
        "bank_id": {"type": "string"},
        "origin": {"type": "string"},
        "origin_id": {"type": "string"},
        "source_locator": {"type": "string"},
        "related_thesis": {"type": "string"},
        "related_thesis_status": {"type": "string"},
        "type": {"type": "string"}
      },
      "additionalProperties": false
    },
    "bank": {
      "type": "object",
      "required": ["id", "concept_id", "type", "type_name", "text", "provenance"],
      "properties": {
        "id": {"type": "string", "pattern": "^BM-[0-9]{4}$"},
        "concept_id": {"$ref": "#/$defs/identifier"},
        "type": {"enum": ["E", "T", "EV", "D", "C", "V", "R", "I"]},
        "type_name": {"type": "string", "minLength": 2},
        "text": {"type": "string", "minLength": 20},
        "provenance": {"type": "string", "minLength": 10}
      },
      "additionalProperties": false
    }
  }
}
